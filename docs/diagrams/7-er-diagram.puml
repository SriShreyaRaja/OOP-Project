@startuml
title I-ITSM — Suggested Database Schema (ER)
hide circle
skinparam linetype ortho
entity users {
  * user_id : VARCHAR <<PK>>
  --
  name : VARCHAR
  email : VARCHAR <<UNIQUE>>
  role : VARCHAR
  password_hash : VARCHAR
  active : BOOLEAN
  department : VARCHAR
  skills : VARCHAR  «NETWORK=5,…»
  max_workload_points : INT
  years_experience : DOUBLE
  available : BOOLEAN
}
entity services {
  * service_id : VARCHAR <<PK>>
  --
  name : VARCHAR
  business_criticality : INT
  default_category : VARCHAR
  keywords : VARCHAR
  owner : VARCHAR
}
entity service_dependencies {
  * service_id : VARCHAR <<FK>>
  * depends_on_id : VARCHAR <<FK>>
}
entity incidents {
  * incident_id : VARCHAR <<PK>>
  --
  reporter_id : VARCHAR <<FK>>
  service_id : VARCHAR <<FK>>
  assignee_id : VARCHAR <<FK>>
  title, description : TEXT
  impact, urgency, priority, status, category : VARCHAR
  affected_users : INT
  priority_explanation : TEXT
  created_at, resolved_at, closed_at : TIMESTAMP
  sla_* : (paused, responded, flags)
  escalation_level : INT
  related_incidents : VARCHAR
  feedback_rating : INT
}
entity incident_notes {
  * id : INT <<PK>>
  --
  incident_id : VARCHAR <<FK>>
  author_id : VARCHAR <<FK>>
  text : TEXT
  internal : BOOLEAN
  at : TIMESTAMP
}
entity incident_resolutions {
  * id : INT <<PK>>
  --
  incident_id : VARCHAR <<FK>>
  technician_id : VARCHAR <<FK>>
  description, root_cause, preventive_action : TEXT
  at : TIMESTAMP
}
entity audit_events {
  * id : INT <<PK>>
  --
  incident_id : VARCHAR <<FK>>
  actor_id : VARCHAR
  event_type : VARCHAR
  previous_state, new_state : VARCHAR
  description : TEXT
  at : TIMESTAMP
}
entity categories {
  * name : VARCHAR <<PK>>
  --
  description : VARCHAR
  keywords : VARCHAR
}
entity sla_policies {
  * priority : VARCHAR <<PK>>
  * service_id : VARCHAR <<PK, nullable>>
  --
  response_minutes : INT
  resolution_minutes : INT
  warning_threshold : DOUBLE
}

users ||--o{ incidents : reports
users |o--o{ incidents : assigned
services ||--o{ incidents : affected
services ||--o{ service_dependencies
incidents ||--o{ incident_notes
incidents ||--o{ incident_resolutions
incidents ||--o{ audit_events
services |o--o{ sla_policies
@enduml
