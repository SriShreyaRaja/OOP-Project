@startuml
title I-ITSM — Layered Architecture
skinparam componentStyle rectangle
skinparam rectangleBackgroundColor #F5F8FF
skinparam rectangleBorderColor #3B5BA9

rectangle "Presentation (Member 1)\nEmployee portal · Technician workspace · Admin dashboard" as UI
rectangle "REST API (Member 3)\nSpring Boot controllers · JWT auth · @Scheduled monitor\nITSMException → HTTP status" as API
rectangle "Domain Layer (Member 2) — pure Java, no framework" as DOM {
  rectangle "ServiceDesk (Facade)" as SD
  rectangle "Incident + State pattern\nSLA clock · Users & roles" as CORE
  rectangle "Strategies\npriority · assignment" as STR
  rectangle "Events (Observer)\naudit · notifications (Adapter)" as EVT
  rectangle "Intelligence (Member 4 can upgrade)\nduplicates · correlation · SLA risk\nwhat-if · suggested fixes · escalation" as AI
}
rectangle "Persistence (Member 3)\nStorageAdapter → JDBC / JPA" as PERS
database "Database\n(SQLite / PostgreSQL)" as DB

UI --> API : HTTPS + JSON
API --> SD : method calls
SD --> CORE
SD --> STR
SD --> EVT
SD --> AI
SD --> PERS : save…() / load…()
PERS --> DB
@enduml
